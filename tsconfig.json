{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["*.ts", "__test__/**/*.ts", "src/runtime/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
